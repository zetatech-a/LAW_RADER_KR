# 로컬 실행용 환경변수 예시. 실제 값으로 채워 `.env` 로 복사한 뒤
#   set -a; source .env; set +a
# 로 로드하거나, export 하여 사용하세요. (.env 는 커밋 금지 — .gitignore 에 포함)
#
# GitHub Actions 에서는 이 값들을 저장소 Secrets 로 등록합니다:
#   Settings → Secrets and variables → Actions → New repository secret

# --- Gmail SMTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# 보내는 Gmail 주소
SMTP_USER=sample@example.com
# Gmail '앱 비밀번호' 16자리 (일반 로그인 비밀번호 아님).
# 2단계 인증 활성화 후 https://myaccount.google.com/apppasswords 에서 발급.
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
# 발신 표시 주소(미지정 시 SMTP_USER 사용)
MAIL_FROM=sample@example.com
# 수신자(필수). 여러 명은 쉼표 또는 세미콜론으로 구분.
# 실제 주소는 저장소에 커밋하지 말고 여기(.env, 커밋 제외)나 GitHub Secrets 에만 두세요.
MAIL_TO=recipient@example.com
