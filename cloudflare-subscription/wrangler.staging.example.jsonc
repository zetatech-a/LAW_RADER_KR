{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 스테이징 전용 설정 예시(Phase 3A). 사용법:
  //   cp wrangler.staging.example.jsonc wrangler.staging.jsonc   ← 복사본은 .gitignore 대상, 커밋 금지
  //   아래 <...> 3곳을 스테이징 값으로 채운 뒤 모든 wrangler 명령에 `-c wrangler.staging.jsonc` 를 붙인다.
  // 운영 설정(wrangler.jsonc)과 이름·계정·D1 이 모두 달라야 한다. 자리표시자 그대로면 원격 명령이 실패한다(안전한 실패).
  "name": "law-rader-subscription-staging",
  // 스테이징 Cloudflare 계정 ID(`npx wrangler whoami` 출력). 다른 계정으로 로그인돼 있으면 명령이 거절된다.
  "account_id": "<STAGING_ACCOUNT_ID>",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-28",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "PUBLIC_ORIGIN": "https://law-rader-subscription-staging.<STAGING_SUBDOMAIN>.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "law-rader-subscription-staging",
      // `npx wrangler d1 create law-rader-subscription-staging -c wrangler.staging.jsonc` 이 출력한 ID.
      "database_id": "<STAGING_D1_DATABASE_ID>",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["17 18 * * *"]
  }
  // Secret(값은 여기 쓰지 않는다 — `wrangler secret put <이름> -c wrangler.staging.jsonc` 프롬프트로만):
  //   INTERNAL_API_TOKEN, SUBSCRIBER_HASH_KEY, SERVER_SECRET, APPS_SCRIPT_URL, APPS_SCRIPT_SHARED_SECRET
  //   모두 스테이징 전용으로 새로 만들고 운영에 재사용하지 않는다.
}
